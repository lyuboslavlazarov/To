# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ключ-anon-или-publishable
# Тайният ключ – САМО на сървъра, никога не го споделяйте
SUPABASE_SERVICE_ROLE_KEY=ключ-service_role-или-secret

# --- Адрес на сайта (без / накрая) ---
NEXT_PUBLIC_SITE_URL=https://vashiat-domein.bg

# --- Push известия (генерирайте с: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@vashiat-domein.bg

# --- Имейли (resend.com – безплатен план) ---
RESEND_API_KEY=
EMAIL_FROM="Организацията <noreply@vashiat-domein.bg>"

# --- Защита на автоматичните задачи (cron) – произволен дълъг низ ---
CRON_SECRET=
